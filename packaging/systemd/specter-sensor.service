[Unit]
Description=SPECTER-NET RF Sensor
After=network.target
Wants=specter-core.service

[Service]
Type=simple
User=specter
Group=specter
ExecStart=/usr/local/bin/specter-sensor
Restart=always
RestartSec=5
Environment=SPECTER_CONFIG=/etc/specter-net/specter.toml
Environment=RUST_LOG=info

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/specter-net /var/log/specter-net
PrivateTmp=true

[Install]
WantedBy=multi-user.target
